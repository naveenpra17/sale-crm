# Backend
DATABASE_URL=jdbc:postgresql://localhost:5432/acres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
FRONTEND_URL=http://localhost:4200
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
APP_TIMEZONE=Asia/Kolkata
ACCESS_TOKEN_EXPIRATION=15
REFRESH_TOKEN_EXPIRATION=30
SWAGGER_ENABLED=true

# For local development with seed accounts, run backend with:
# SPRING_PROFILES_ACTIVE=seed
